{
  "name": "@shaowenchen/dsh-subprocess-node",
  "version": "0.1.0",
  "description": "dsh ctx.subprocess backed by a remote node: commands, terminals, and language servers run on the machine connected over the node channel",
  "license": "MIT",
  "author": "Shaowen Chen <mail@chenshaowen.com>",
  "homepage": "https://github.com/shaowenchen/deepseek-harness-remote-node#readme",
  "bugs": {
    "url": "https://github.com/shaowenchen/deepseek-harness-remote-node/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=15000 \"tests/*.spec.ts\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "subprocess",
    "terminal",
    "pty",
    "remote",
    "node",
    "execution-world",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaowenchen/deepseek-harness-remote-node.git",
    "directory": "packages/subprocess-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@shaowenchen/dsh-node": "^0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.2-rc.1",
    "@shaowenchen/dsh-node": "file:../node",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
